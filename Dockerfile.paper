FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY market_symbols.py paper_trader.py risk_analysis.py server_paper_trader.py ./
RUN useradd --system --uid 10001 --create-home trader
USER trader
CMD ["python", "-u", "server_paper_trader.py"]
